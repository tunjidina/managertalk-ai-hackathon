# ManagerTalk: example environment file. PLACEHOLDERS ONLY.
#
# Copy to the file named in each section and edit. Never put real keys,
# tokens, service-account files or other secrets in a tracked file. Every
# variable starting REACT_APP_ is inlined into the public JavaScript bundle
# by Create React App, so it must never hold a secret.

# --- Local emulator development: copy to .env.development.local (gitignored) ---
# Used by `npm start` together with the Firebase emulators. The project ID
# must start with "demo-": it names an emulator-only project that cannot
# exist in the cloud. The other values are made-up placeholders; the
# emulators do not check them.
REACT_APP_FIREBASE_API_KEY=placeholder-not-a-real-key
REACT_APP_FIREBASE_AUTH_DOMAIN=localhost
REACT_APP_FIREBASE_PROJECT_ID=demo-managertalk
REACT_APP_FIREBASE_STORAGE_BUCKET=demo-managertalk.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Connect sign-in to the local Auth emulator. Honoured only in development
# mode (`npm start`), only for a "demo-" project and only for a loopback
# http:// address (see src/lib/authEmulator.ts).
REACT_APP_USE_AUTH_EMULATOR=true
REACT_APP_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# The S02 conversation endpoint: the only path the client allows is
# /api/s02/turn (see ALLOWED_API_PATHS in src/engine/s02/conversationEngine.ts).
# During `npm start`, the "proxy" setting in package.json forwards it to the
# Firebase Hosting emulator on 127.0.0.1:5000.
REACT_APP_S02_ENGINE_ENDPOINT=/api/s02/turn

# --- Real Firebase project (production-style build): .env.local, gitignored ---
# Use the values from your own Firebase console for the same six
# REACT_APP_FIREBASE_* names above. Do not copy real values into this file.

# RevenueCat Web Billing key (src/lib/purchases.ts). Leave EMPTY for the
# hackathon demo: an empty value disables RevenueCat, so no purchase or
# entitlement requests are made. Never commit a real key.
REACT_APP_REVENUECAT_WEB_BILLING_KEY=

# Hackathon demo build only: set to true to open MT-S02 without a purchase.
# Ignored (stays off) if a RevenueCat key above is set. Leave empty otherwise.
REACT_APP_DEMO_MODE=
