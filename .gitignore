# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# environment files and local secrets: ignore every .env variant, but keep
# the placeholder-only example trackable
.env
.env.*
!.env.example
.secret.local

# Firebase CLI / emulator caches and logs
.firebase/
*-debug.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# signing keys — never commit these
*.jks
*.keystore
keystore.properties

# build output from the Android Studio signed-bundle wizard
android/app/release/

# IDE state
.idea/

MANAGERTALK_HANDOVER.md

# Cloudflare Wrangler: local secrets and state
.dev.vars
.wrangler/
